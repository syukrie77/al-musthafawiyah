# ── Al-Musthafawiyah Automation Config ─────────────────────
# Copy file ini ke .env dan isi nilainya.

# ── AI (OpenAI-compatible) ─────────────────────────────────
AI_BASE_URL=https://ai.sumopod.com/v1
AI_API_KEY=
AI_MODEL=deepseek-v4.1-flash:netra

# ── Facebook Fanpage ────────────────────────────────────────
# Dapatkan dari: https://developers.facebook.com/tools/explorer/
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# ── Instagram Business/Creator ──────────────────────────────
# Harus akun Business/Creator yang terhubung ke Facebook Page
IG_USER_ID=
IG_ACCESS_TOKEN=

# ── Site URL ────────────────────────────────────────────────
SITE_URL=https://mockup1.aretanet.com

# ── Deploy target (webroot nginx) ───────────────────────────
WEBROOT=/var/www/mockup1.aretanet.com

# ── Google Drive (Service Account) — cover & tema blog ─────
# Isi nanti saat integrasi GDrive aktif.
GDRIVE_SERVICE_ACCOUNT_JSON=
GDRIVE_COVER_FOLDER_ID=
