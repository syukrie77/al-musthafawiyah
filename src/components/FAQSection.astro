---
import site from '../data/site.json';
import { faqSchema } from '../lib/seo';

const faq = site.faq ?? [];
const schema = faqSchema(faq);
---

{faq.length > 0 && (
  <section class="bg-white py-16 sm:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <span class="inline-block bg-brand-50 text-brand-700 text-xs font-semibold px-3 py-1 rounded-full mb-3">❓ FAQ</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-brand-800">Pertanyaan yang Sering Diajukan</h2>
      </div>

      <div class="space-y-4" id="faq-list">
        {faq.map((item, i) => (
          <div class="faq-item border border-gray-100 rounded-xl overflow-hidden" data-open={i === 0 ? 'true' : 'false'}>
            <button
              class="faq-toggle w-full flex items-center justify-between px-5 py-4 text-left hover:bg-gray-50 transition"
              aria-expanded={i === 0}
            >
              <span class="font-semibold text-gray-900 text-sm sm:text-base">{item.q}</span>
              <svg class={`w-5 h-5 text-gray-400 transition-transform shrink-0 ml-4 ${i === 0 ? 'rotate-180' : ''}`} viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </button>
            <div class={`faq-answer px-5 ${i === 0 ? 'pb-5' : 'hidden'}`}>
              <p class="text-sm text-gray-600 leading-relaxed">{item.a}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-8 text-center">
        <a
          href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Assalamu\'alaikum, saya ingin bertanya lebih lanjut tentang Al-Musthafawiyah')}`}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 bg-[#25D366] text-white px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-[#1faa52] transition"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-.607zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
          Masih ada pertanyaan?
        </a>
      </div>
    </div>
  </section>
)}

<script>
  document.querySelectorAll('.faq-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const answer = item?.querySelector('.faq-answer');
      const icon = btn.querySelector('svg');
      const open = item?.getAttribute('data-open') === 'true';

      document.querySelectorAll('.faq-item').forEach((el) => {
        el.setAttribute('data-open', 'false');
        (el.querySelector('.faq-answer') as HTMLElement)?.classList.add('hidden');
        (el.querySelector('.faq-toggle svg') as SVGSVGElement)?.classList.remove('rotate-180');
        (el.querySelector('.faq-toggle') as HTMLButtonElement)?.setAttribute('aria-expanded', 'false');
      });

      if (!open) {
        item?.setAttribute('data-open', 'true');
        answer?.classList.remove('hidden');
        icon?.classList.add('rotate-180');
        (btn as HTMLButtonElement).setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
