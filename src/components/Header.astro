---
import site from '../data/site.json';

const nav = [
  { name: 'Beranda', href: '/' },
  {
    name: 'Profil',
    href: '/tentang',
    children: [
      { name: 'Sejarah & Pendirian', href: '/tentang#sejarah' },
      { name: 'Visi, Misi & Target', href: '/tentang#visi-misi' },
      { name: 'Struktur Organisasi', href: '/tentang#struktur' },
      { name: 'Legalitas & Perizinan', href: '/tentang#legalitas' },
    ],
  },
  {
    name: 'Pendidikan',
    href: '/pendidikan',
    children: [
      { name: 'Program Unggulan', href: '/pendidikan#program-unggulan' },
      { name: 'Madrasah / Sekolah', href: '/pendidikan#formal' },
      { name: 'Takhassus Tahfidz', href: '/pendidikan#takhassus' },
      { name: "Ma'had Aly", href: '/pendidikan#mahad-aly' },
    ],
  },
  {
    name: 'Kesiswaan',
    href: '/pendidikan#kesiswaan',
    children: [
      { name: 'OSMA', href: '/pendidikan#osma' },
      { name: 'Ekstrakurikuler', href: '/pendidikan#ekskul' },
      { name: 'Fasilitas', href: '/pendidikan#fasilitas' },
      { name: 'Jadwal Rutinitas', href: '/pendidikan#jadwal' },
    ],
  },
  { name: 'PPDB', href: '/ppdb', cta: true },
  { name: 'Blog', href: '/blog' },
  { name: 'Alumni', href: '/tentang#alumni' },
  { name: 'Kontak', href: '/kontak' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : href.startsWith('/#') ? false : path.startsWith(href.split('#')[0]));
---

<!-- Top bar: Pojok Wali Santri + language switcher + social -->
<div class="bg-brand-900 text-white/80 text-xs">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 flex items-center justify-between gap-4 h-9">
    <div class="flex items-center gap-4 min-w-0">
      <a href="https://siakad.ponpes.almusthafawiyah.sch.id" target="_blank" rel="noopener" class="hover:text-gold-300 transition whitespace-nowrap">
        <span class="mr-1">👨‍🎓</span> Pojok Wali Santri
      </a>
      <span class="text-white/20 hidden sm:inline">|</span>
      <a href="/kontak" class="hover:text-gold-300 transition whitespace-nowrap hidden sm:inline">
        <span class="mr-1">📡</span> Layanan Dakwah
      </a>
    </div>
    <div class="flex items-center gap-3 shrink-0">
      <div class="flex items-center gap-1">
        <a href="/" class="px-2 py-0.5 rounded text-[11px] font-medium bg-brand-600 border border-brand-600 text-white" title="Bahasa Indonesia">ID</a>
        <a href="/" class="px-2 py-0.5 rounded text-[11px] border border-white/25 hover:bg-white/10 transition" title="English">EN</a>
        <a href="/" class="px-2 py-0.5 rounded text-[11px] border border-white/25 hover:bg-white/10 transition" title="العربية">عربي</a>
      </div>
      <span class="text-white/20">|</span>
      <div class="flex items-center gap-1">
        <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="hover:text-gold-300 transition">f</a>
        <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="hover:text-gold-300 transition">◎</a>
        <a href={site.social.youtube} target="_blank" rel="noopener" aria-label="YouTube" class="hover:text-gold-300 transition">▶</a>
      </div>
    </div>
  </div>
</div>

<header class="sticky top-0 z-40 bg-white/90 backdrop-blur-lg border-b border-gray-100 shadow-sm">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 flex items-center justify-between h-16">
    <a href="/" class="flex items-center gap-3 group" aria-label="Al-Musthafawiyah — Beranda">
      <img
        src="/images/logo-almusthafawiyah.png"
        alt="Pondok Pesantren Al-Musthafawiyah"
        class="h-12 w-auto group-hover:scale-105 transition-transform"
        fetchpriority="high"
      />
      <span class="hidden md:flex flex-col leading-tight">
        <span class="font-serif font-bold text-brand-800 text-lg">Al-Musthafawiyah</span>
        <span class="text-[10px] text-gray-500 uppercase tracking-wider">Pondok Pesantren</span>
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-0.5">
      {nav.map((item) => (
        item.children ? (
          <div class="relative group">
            <a
              href={item.href}
              class={`flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-medium transition ${
                isActive(item.href) ? 'text-brand-700 bg-brand-50' : 'text-gray-600 hover:text-brand-700 hover:bg-gray-50'
              }`}
            >
              {item.name}
              <svg class="w-3 h-3 opacity-60 group-hover:rotate-180 transition-transform" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
            </a>
            <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all translate-y-1 group-hover:translate-y-0 z-50">
              <div class="bg-white rounded-xl shadow-xl ring-1 ring-black/5 py-2 min-w-[220px]">
                {item.children.map((c) => (
                  <a href={c.href} class="block px-4 py-2.5 text-sm text-gray-600 hover:text-brand-700 hover:bg-brand-50 transition whitespace-nowrap">
                    {c.name}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class={`px-3 py-2 rounded-lg text-sm font-medium transition ${
              item.cta
                ? 'bg-gold-400 text-white px-5 shadow-lg shadow-gold-400/20 hover:bg-gold-500 hover:-translate-y-0.5'
                : isActive(item.href)
                ? 'text-brand-700 bg-brand-50'
                : 'text-gray-600 hover:text-brand-700 hover:bg-gray-50'
            }`}
          >
            {item.name}
          </a>
        )
      ))}
    </nav>

    <button id="menu-btn" class="lg:hidden p-2 text-gray-700 hover:text-brand-600" aria-label="Buka menu" aria-expanded="false">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-100 bg-white/95 backdrop-blur-lg">
    <nav class="px-4 py-3 space-y-1">
      {nav.map((item) => (
        <a
          href={item.href}
          class={`block px-3 py-2.5 rounded-lg text-sm font-medium ${
            isActive(item.href) ? 'text-brand-700 bg-brand-50' : 'text-gray-700 hover:bg-gray-50'
          }`}
        >
          {item.name}
        </a>
      ))}
      <a href="/ppdb" class="block bg-gold-400 text-white px-3 py-3 rounded-lg text-sm font-semibold text-center mt-2">
        Daftar PPDB Sekarang
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const hidden = menu?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', hidden ? 'false' : 'true');
  });
</script>
