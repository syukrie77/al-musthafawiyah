---
import agenda from '../data/agenda.json';
import { eventSchema } from '../lib/seo';

const typeColor: Record<string, string> = {
  'Wisuda': 'bg-emerald-50 text-emerald-700 border-emerald-200',
  'Kegiatan': 'bg-amber-50 text-amber-700 border-amber-200',
  'PPDB': 'bg-brand-50 text-brand-700 border-brand-200',
};

const jsonLdEvents = agenda.items.map((ev) => eventSchema(ev));
---

<section id="agenda" class="bg-gradient-to-br from-brand-50 to-white py-16 sm:py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-10">
      <span class="inline-block bg-brand-100 text-brand-700 text-xs font-semibold px-3 py-1 rounded-full mb-3">📅 {agenda.title}</span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-brand-800">{agenda.title}</h2>
      <p class="mt-3 text-lg text-gray-600 max-w-xl mx-auto">{agenda.subtitle}</p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      {agenda.items.map((ev) => (
        <a href={ev.link} class="group relative block rounded-2xl border border-gray-100 bg-white p-6 hover:shadow-xl hover:border-brand-200 transition-all">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-14 h-14 rounded-xl bg-brand-600 text-white flex flex-col items-center justify-center">
              <span class="text-xs font-bold leading-none">{new Date(ev.date).toLocaleDateString('id-ID', { month: 'short' }).toUpperCase()}</span>
              <span class="text-xl font-extrabold leading-tight">{new Date(ev.date).getDate()}</span>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class={`text-xs font-semibold px-2 py-0.5 rounded-full border ${typeColor[ev.type] ?? 'bg-gray-50 text-gray-600 border-gray-200'}`}>
                  {ev.type}
                </span>
              </div>
              <h3 class="font-serif font-bold text-gray-900 group-hover:text-brand-700 leading-snug">{ev.title}</h3>
              <p class="mt-1 text-sm text-gray-500">{ev.desc}</p>
              <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-gray-400">
                <span>🕐 {ev.time}</span>
                <span>📍 {ev.place}</span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="text-center mt-8">
      <a href="/kontak" class="inline-flex items-center gap-2 text-sm font-semibold text-brand-700 hover:text-brand-800">
        Lihat semua kegiatan →
      </a>
    </div>
  </div>

  {jsonLdEvents.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
</section>
