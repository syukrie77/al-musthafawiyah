---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import site from '../../data/site.json';
import { articleSchema, breadcrumbSchema, absoluteUrl, jsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const title = post.data.seoTitle || post.data.title;
const description = post.data.seoDescription || post.data.description;
const cover = post.data.cover ? absoluteUrl(post.data.cover) : absoluteUrl(site.ogImage);

const breadcrumbs = breadcrumbSchema([
  { name: 'Beranda', url: '/' },
  { name: 'Blog', url: '/blog' },
  { name: post.data.title, url: `/blog/${post.slug}/` },
]);

const article = articleSchema({
  title: post.data.title,
  description: post.data.description,
  date: post.data.date,
  author: post.data.author,
  cover: post.data.cover,
  slug: post.slug,
});

const extraJsonLd = [breadcrumbs, article];
---

<Layout
  title={title}
  description={description}
  image={post.data.cover || site.ogImage}
  type="article"
  publishedTime={post.data.date.toISOString()}
  breadcrumbs={[{ name: 'Beranda', url: '/' }, { name: 'Blog', url: '/blog' }, { name: post.data.title, url: `/blog/${post.slug}/` }]}
  extraJsonLd={extraJsonLd}
>
  <article class="py-12 sm:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <!-- Breadcrumb visual -->
      <nav class="text-sm text-gray-500 mb-6">
        <a href="/" class="hover:text-brand-600">Beranda</a> <span class="mx-1">/</span>
        <a href="/blog" class="hover:text-brand-600">Blog</a> <span class="mx-1">/</span>
        <span class="text-gray-700">{post.data.title}</span>
      </nav>

      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-brand-800 leading-tight">{post.data.title}</h1>
      <div class="flex items-center gap-3 mt-4 text-sm text-gray-500">
        <span class="text-brand-600 font-semibold">{post.data.date.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
        <span>•</span>
        <span>{post.data.author}</span>
      </div>

      {post.data.cover && (
        <img src={post.data.cover} alt={post.data.title} class="w-full rounded-2xl mt-8 shadow-lg" loading="eager" />
      )}

      <div class="prose prose-lg prose-brand max-w-none mt-8">
        <Content />
      </div>

      <!-- Share -->
      <div class="mt-10 pt-6 border-t border-gray-100">
        <p class="text-sm font-semibold text-gray-700 mb-3">Bagikan artikel ini:</p>
        <div class="flex gap-2 flex-wrap">
          <a href={`https://wa.me/?text=${encodeURIComponent(post.data.title + ' ' + absoluteUrl(`/blog/${post.slug}/`))}`} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 bg-[#25D366] text-white px-4 py-2 rounded-full text-sm font-medium hover:bg-[#1faa52] transition">💬 WhatsApp</a>
          <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(absoluteUrl(`/blog/${post.slug}/`))}`} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 bg-[#1877f2] text-white px-4 py-2 rounded-full text-sm font-medium hover:bg-[#1664d9] transition">f Facebook</a>
          <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(absoluteUrl(`/blog/${post.slug}/`))}&text=${encodeURIComponent(post.data.title)}`} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 bg-black text-white px-4 py-2 rounded-full text-sm font-medium hover:bg-gray-800 transition">𝕏 Twitter</a>
        </div>
      </div>

      <!-- Back -->
      <div class="mt-8">
        <a href="/blog" class="inline-flex items-center gap-2 text-brand-600 hover:text-brand-700 font-semibold text-sm">← Kembali ke Blog</a>
      </div>
    </div>
  </article>
</Layout>

<style is:global>
  .prose-brand {
    --tw-prose-links: #1a6b3c;
    --tw-prose-headings: #0d4a2a;
  }
</style>
