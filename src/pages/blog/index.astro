---
import Layout from '../../layouts/Layout.astro';
import site from '../../data/site.json';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout
  title="Blog & Berita"
  description="Artikel islami, berita pesantren, dan pengumuman terbaru dari Pondok Pesantren Al-Musthafawiyah."
  breadcrumbs={[{ name: 'Beranda', url: '/' }, { name: 'Blog', url: '/blog' }]}
>
  <section class="bg-gradient-to-br from-brand-800 to-brand-600 text-white py-16 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center">
      <h1 class="font-serif text-4xl sm:text-5xl font-bold">Blog & Berita</h1>
      <p class="mt-4 text-lg text-brand-100 max-w-2xl mx-auto">Kabar pesantren, artikel islami, dan pengumuman yang di-update secara berkala.</p>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      {posts.length === 0 ? (
        <div class="text-center text-gray-500 py-12">
          <p>Belum ada artikel. Nantikan konten terbaru dari kami!</p>
        </div>
      ) : (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <a href={`/blog/${post.slug}/`} class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition hover:-translate-y-1">
              <div class="h-48 overflow-hidden">
                <img src={post.data.cover || site.ogImage} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition" loading="lazy" />
              </div>
              <div class="p-5">
                <span class="text-xs font-semibold text-brand-600">{post.data.date.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
                <h2 class="font-serif font-bold text-brand-800 mt-1 leading-snug group-hover:text-brand-600 transition">{post.data.title}</h2>
                <p class="text-sm text-gray-500 mt-1 line-clamp-2">{post.data.description}</p>
                <span class="inline-flex items-center gap-1 text-brand-600 font-semibold text-sm mt-3 group-hover:gap-2 transition">Baca Selengkapnya →</span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>
