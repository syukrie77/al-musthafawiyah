---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import SectionTitle from '../components/SectionTitle.astro';

const alur = [
  ['1', 'Isi Formulir Online', 'Lengkapi data diri & pilihan program di formulir PPDB.'],
  ['2', 'Unggah Dokumen', 'Rapor, akta kelahiran, dan dokumen pendukung lainnya.'],
  ['3', 'Tes Seleksi', 'Tes membaca Al-Qur\'an & wawancara dengan pengasuh.'],
  ['4', 'Pengumuman', 'Hasil seleksi diumumkan melalui WhatsApp & website.'],
  ['5', 'Daftar Ulang', 'Lakukan daftar ulang & ikuti orientasi santri baru.'],
];

const biaya = [
  ['Formulir Pendaftaran', 'Gratis'],
  ['Uang Pangkal', 'Sesuai program'],
  ['SPP Bulanan', 'Sesuai jenjang'],
  ['Asrama', 'Termasuk paket'],
];
---

<Layout
  title="PPDB 2027/2028"
  description="Pendaftaran Peserta Didik Baru Pondok Pesantren Al-Musthafawiyah tahun ajaran 2027/2028. Informasi alur, syarat, dan biaya pendaftaran."
  breadcrumbs={[{ name: 'Beranda', url: '/' }, { name: 'PPDB', url: '/ppdb' }]}
>
  <section class="bg-gradient-to-br from-brand-800 to-brand-600 text-white py-16 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center">
      <span class="inline-block bg-gold-400 text-white text-xs font-bold px-4 py-1 rounded-full mb-4">PPDB 2027/2028 TELAH DIBUKA</span>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold">Pendaftaran Santri Baru</h1>
      <p class="mt-4 text-lg text-brand-100 max-w-2xl mx-auto">Segera daftarkan putra-putri Anda untuk bergabung bersama ribuan santri Pondok Pesantren Al-Musthafawiyah.</p>
      <div class="mt-8 flex gap-4 justify-center flex-wrap">
        <a href="https://psb.almusthafawiyah.sch.id" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-gold-400 hover:bg-gold-500 text-white px-7 py-3.5 rounded-full font-bold text-base transition hover:-translate-y-0.5 shadow-lg shadow-gold-400/30">
          ↗ Formulir Pendaftaran Online
        </a>
        <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" class="inline-flex items-center gap-2 border-2 border-white/50 hover:bg-white hover:text-brand-700 text-white px-7 py-3.5 rounded-full font-semibold text-base transition">
          💬 Chat Admin
        </a>
      </div>
    </div>
  </section>

  <!-- Alur -->
  <section class="py-16 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <SectionTitle eyebrow="Alur" title="Alur Pendaftaran" subtitle="Lima langkah mudah untuk menjadi bagian dari keluarga besar Al-Musthafawiyah." />
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
        {alur.map(([no, title, desc]) => (
          <div class="bg-white rounded-2xl p-6 shadow-sm text-center relative">
            <div class="w-10 h-10 bg-brand-600 text-white rounded-full flex items-center justify-center font-bold mx-auto mb-3">{no}</div>
            <h3 class="font-serif font-bold text-brand-800 text-sm mb-1">{title}</h3>
            <p class="text-xs text-gray-500">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Syarat -->
  <section class="bg-brand-50 py-16 sm:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <SectionTitle eyebrow="Syarat" title="Syarat Pendaftaran" />
      <div class="bg-white rounded-2xl shadow-sm p-6">
        <ul class="space-y-3 text-sm text-gray-600">
          {[
            'Fotokopi akta kelahiran / kartu keluarga',
            'Fotokopi rapor terakhir',
            'Pas foto 3x4 (2 lembar)',
            'Mengisi formulir pendaftaran online',
            'Mengikuti tes seleksi & wawancara',
          ].map((li) => (
            <li class="pl-6 relative"><span class="absolute left-0 text-brand-600">✓</span>{li}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Biaya -->
  <section class="py-16 sm:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <SectionTitle eyebrow="Biaya" title="Informasi Biaya" subtitle="Rincian biaya pendaftaran dan pendidikan. Untuk detail lengkap silakan hubungi admin." />
      <div class="bg-white rounded-2xl overflow-hidden shadow-sm">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-brand-600 text-white">
              <th class="text-left px-5 py-3 font-semibold">Komponen</th>
              <th class="text-left px-5 py-3 font-semibold">Keterangan</th>
            </tr>
          </thead>
          <tbody>
            {biaya.map(([k, v]) => (
              <tr class="border-b border-gray-100">
                <td class="px-5 py-3 font-medium text-gray-700">{k}</td>
                <td class="px-5 py-3 text-gray-600">{v}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-sm text-gray-500 mt-4 text-center">Tersedia program beasiswa tahfidz & santri berprestasi, serta keringanan untuk yatim dan dhuafa.</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-br from-brand-800 to-brand-600 text-white py-16 text-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="font-serif text-3xl font-bold">Siap Bergabung?</h2>
      <p class="mt-3 text-brand-100">Daftar sekarang dan wujudkan generasi Qur'ani yang berilmu dan berakhlak mulia.</p>
      <div class="mt-7 flex gap-4 justify-center flex-wrap">
        <a href="https://psb.almusthafawiyah.sch.id" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-gold-400 hover:bg-gold-500 text-white px-7 py-3.5 rounded-full font-bold transition hover:-translate-y-0.5">↗ Daftar Sekarang</a>
        <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" class="inline-flex items-center gap-2 border-2 border-white/50 hover:bg-white hover:text-brand-700 text-white px-7 py-3.5 rounded-full font-semibold transition">💬 Tanya Admin</a>
      </div>
    </div>
  </section>
</Layout>
